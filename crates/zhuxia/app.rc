#pragma code_page(65001)

// 版本号不写死：build.rs 用 `CARGO_PKG_VERSION`（= Cargo.toml 的 workspace version）
// 把版本占位符换成实际版本、图标路径换成绝对路径后编译。
// 手改这里的占位符没有意义，改版本请改 Cargo.toml。

1 ICON "@ICON@"

1 VERSIONINFO
FILEVERSION @VERSION4@
PRODUCTVERSION @VERSION4@
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080404b0"
    BEGIN
      VALUE "CompanyName", "Zhuxia"
      VALUE "FileDescription", "驻匣 Zhuxia - 常驻系统监视"
      VALUE "FileVersion", "@VERSION@"
      VALUE "InternalName", "zhuxia"
      VALUE "OriginalFilename", "zhuxia.exe"
      VALUE "ProductName", "驻匣 Zhuxia"
      VALUE "ProductVersion", "@VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x804, 1200
  END
END
